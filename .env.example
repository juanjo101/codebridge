# NVIDIA NIM API credentials
# ACTION REQUIRED: Set your NVIDIA API key here
NVIDIA_API_KEY=

# NVIDIA NIM base URL (default: hosted service)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model for NVIDIA NIM (set after running: codebridge models)
# Example: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_DEFAULT_MODEL=

# Fallback model if default is unavailable
NVIDIA_FALLBACK_MODEL=

# ── CodeBridge Server ──────────────────────────────────────────────
# Bind host — KEEP as 127.0.0.1 for local-only access
CODEBRIDGE_HOST=127.0.0.1
CODEBRIDGE_PORT=8787

# Local authentication token for Codex → CodeBridge
# Leave empty to auto-generate on first start (recommended)
CODEBRIDGE_LOCAL_TOKEN=

# ── Protocol ───────────────────────────────────────────────────────
# Enable fallback to /v1/chat/completions when /v1/responses is unsupported
# NVIDIA hosted service does NOT support /v1/responses; keep true
CODEBRIDGE_RESPONSES_FALLBACK=true

# ── Model Cache ────────────────────────────────────────────────────
# How long (seconds) to cache the NVIDIA model list
CODEBRIDGE_MODEL_CACHE_TTL=300

# ── Logging ────────────────────────────────────────────────────────
CODEBRIDGE_LOG_LEVEL=INFO

# WARNING: Enabling this logs full prompt content — do not use in shared environments
CODEBRIDGE_LOG_PROMPTS=false

# ── Telemetry (LOCAL ONLY — nothing sent externally) ───────────────
CODEBRIDGE_TELEMETRY=true

# ── Timeouts ───────────────────────────────────────────────────────
CODEBRIDGE_CONNECT_TIMEOUT=10
CODEBRIDGE_READ_TIMEOUT=300
