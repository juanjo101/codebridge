#!/usr/bin/env bash
# cb — Lanzador ultra corto para CodeBridge Gateway y MCP

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

case "$1" in
    mcp)
        echo "⚡ CodeBridge MCP Launcher"
        echo "================================"
        if ! curl -s http://127.0.0.1:8787/health > /dev/null 2>&1; then
            echo "Starting CodeBridge Gateway in background..."
            bash "$DIR/scripts/start_daemon.sh" > /dev/null 2>&1
        fi
        TOKEN=$(cat "$DIR/.codebridge_token" 2>/dev/null || echo "Token not generated")
        echo "✓ Gateway active: http://127.0.0.1:8787"
        echo "✓ MCP SSE:       http://127.0.0.1:8787/mcp/sse"
        echo "✓ Auth Token:    $TOKEN"
        ;;
    stop)
        PID_ON_PORT=$(lsof -t -i:8787 2>/dev/null)
        if [ -n "$PID_ON_PORT" ]; then
            kill -9 "$PID_ON_PORT" 2>/dev/null
            echo "✓ CodeBridge stopped (PID: $PID_ON_PORT)"
        else
            echo "CodeBridge is not running."
        fi
        ;;
    logs)
        tail -n 40 -f "$DIR/codebridge_server.log"
        ;;
    alias)
        echo "Add this line to your ~/.bashrc or ~/.zshrc:"
        echo "  alias cb=\"$DIR/scripts/cb\""
        ;;
    *)
        if ! curl -s http://127.0.0.1:8787/health > /dev/null 2>&1; then
            bash "$DIR/scripts/start_daemon.sh"
        else
            echo "✓ CodeBridge is running on http://127.0.0.1:8787"
            TOKEN=$(cat "$DIR/.codebridge_token" 2>/dev/null)
            echo "  Token: $TOKEN"
            echo "  MCP SSE: http://127.0.0.1:8787/mcp/sse"
        fi
        ;;
esac
